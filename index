<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>🍎 Catch the Apples</title>
<style>
  :root {
    --bg-top: #87CEEB;
    --bg-bottom: #E0F7FA;
    --accent: #E53935;
    --accent-dark: #B71C1C;
    --leaf: #2E7D32;
    --basket: #8D6E63;
    --basket-dark: #5D4037;
    --panel-bg: rgba(255, 255, 255, 0.92);
    --text-dark: #2b2b2b;
    --success: #43A047;
    --danger: #E53935;
  }

  * { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
    height: 100%;
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    background: linear-gradient(180deg, var(--bg-top) 0%, var(--bg-bottom) 100%);
    overflow: hidden;
    touch-action: none;
    user-select: none;
  }

  #game-container {
    position: relative;
    width: 100%;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  canvas {
    display: block;
    background: linear-gradient(180deg, #A8DDF0 0%, #F0FAF0 100%);
    border-radius: 12px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.25);
    touch-action: none;
    max-width: 100%;
    max-height: 100%;
  }

  #hud {
    position: absolute;
    top: 16px;
    left: 50%;
    transform: translateX(-50%);
    width: min(600px, 92%);
    display: flex;
    justify-content: space-between;
    align-items: center;
    pointer-events: none;
    font-weight: 700;
    color: var(--text-dark);
  }

  .hud-pill {
    background: var(--panel-bg);
    padding: 8px 16px;
    border-radius: 999px;
    box-shadow: 0 3px 10px rgba(0,0,0,0.15);
    font-size: 15px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  #lives-pill .heart {
    color: var(--danger);
    font-size: 16px;
  }

  #overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0,0,0,0.45);
    border-radius: 12px;
  }

  #overlay.hidden { display: none; }

  .panel {
    background: var(--panel-bg);
    padding: 32px 36px;
    border-radius: 16px;
    text-align: center;
    max-width: 340px;
    box-shadow: 0 15px 50px rgba(0,0,0,0.3);
  }

  .panel h1 {
    margin: 0 0 8px;
    font-size: 28px;
    color: var(--text-dark);
  }

  .panel p {
    margin: 4px 0 20px;
    color: #555;
    font-size: 14px;
    line-height: 1.5;
  }

  .panel .stat-line {
    font-size: 16px;
    margin: 6px 0;
    color: var(--text-dark);
  }

  .panel .stat-line strong {
    color: var(--accent-dark);
  }

  button.primary-btn {
    background: var(--success);
    color: white;
    border: none;
    padding: 12px 28px;
    font-size: 16px;
    font-weight: 700;
    border-radius: 999px;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(67, 160, 71, 0.4);
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }

  button.primary-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(67, 160, 71, 0.5);
  }

  button.primary-btn:active {
    transform: translateY(0);
  }

  #controls-hint {
    position: absolute;
    bottom: 14px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 12px;
    color: rgba(43,43,43,0.7);
    background: rgba(255,255,255,0.6);
    padding: 4px 12px;
    border-radius: 999px;
    pointer-events: none;
    white-space: nowrap;
  }

  @media (max-width: 480px) {
    .panel { padding: 24px 22px; max-width: 280px; }
    .panel h1 { font-size: 22px; }
    #controls-hint { font-size: 10px; }
  }
</style>
</head>
<body>

<div id="game-container">
  <canvas id="game-canvas"></canvas>

  <div id="hud">
    <div class="hud-pill" id="score-pill">🍎 Score: <span id="score-value">0</span></div>
    <div class="hud-pill" id="lives-pill">Lives: <span id="lives-value"></span></div>
  </div>

  <div id="controls-hint">← → or A/D to move · drag/tap also works</div>

  <div id="overlay">
    <div class="panel">
      <h1>🍎 Catch the Apples</h1>
      <p>Move the basket left and right to catch falling apples.<br>Miss 3 apples and it's game over!</p>
      <button class="primary-btn" id="start-btn">Start Game</button>
    </div>
  </div>
</div>

<script>
(function () {
  'use strict';

  // ---------------------------------------------------------------------
  // Configuration
  // ---------------------------------------------------------------------
  const CONFIG = {
    baseWidth: 480,
    baseHeight: 640,
    maxLives: 3,
    basket: {
      width: 90,
      height: 55,
      speed: 480,           // px/sec, used for keyboard movement
    },
    apple: {
      radius: 18,
      minSpeed: 140,        // px/sec falling speed at start
      maxSpeedCap: 480,     // px/sec hard cap for difficulty scaling
      spawnIntervalStart: 1100, // ms between spawns at start
      spawnIntervalMin: 420,    // fastest spawn interval
    },
    difficulty: {
      // Every N points, speed & spawn rate ramp up a bit.
      rampEveryPoints: 5,
      speedIncreasePerRamp: 22,
      spawnDecreasePerRamp: 55,
    }
  };

  // ---------------------------------------------------------------------
  // DOM references
  // ---------------------------------------------------------------------
  const canvas = document.getElementById('game-canvas');
  const ctx = canvas.getContext('2d');
  const overlay = document.getElementById('overlay');
  const startBtn = document.getElementById('start-btn');
  const scoreValueEl = document.getElementById('score-value');
  const livesValueEl = document.getElementById('lives-value');

  // ---------------------------------------------------------------------
  // Canvas sizing (responsive, keeps a portrait aspect ratio)
  // ---------------------------------------------------------------------
  let scaleFactor = 1;

  function resizeCanvas() {
    const container = document.getElementById('game-container');
    const availW = container.clientWidth * 0.94;
    const availH = container.clientHeight * 0.94;

    const targetRatio = CONFIG.baseWidth / CONFIG.baseHeight;
    let width = availW;
    let height = width / targetRatio;

    if (height > availH) {
      height = availH;
      width = height * targetRatio;
    }

    canvas.style.width = width + 'px';
    canvas.style.height = height + 'px';

    const dpr = window.devicePixelRatio || 1;
    canvas.width = CONFIG.baseWidth * dpr;
    canvas.height = CONFIG.baseHeight * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    scaleFactor = width / CONFIG.baseWidth;
  }

  window.addEventListener('resize', resizeCanvas);

  // ---------------------------------------------------------------------
  // Game state
  // ---------------------------------------------------------------------
  /** @typedef {{x:number, y:number, speed:number, wobble:number, wobbleSpeed:number}} Apple */

  const state = {
    running: false,
    score: 0,
    lives: CONFIG.maxLives,
    apples: /** @type {Apple[]} */ ([]),
    basketX: CONFIG.baseWidth / 2 - CONFIG.basket.width / 2,
    keys: { left: false, right: false },
    pointerTargetX: null,   // when set, basket eases toward this x (mouse/touch)
    lastTimestamp: 0,
    spawnTimer: 0,
    spawnInterval: CONFIG.apple.spawnIntervalStart,
    appleSpeed: CONFIG.apple.minSpeed,
    animationFrameId: null,
    particles: [],
  };

  function resetState() {
    state.running = true;
    state.score = 0;
    state.lives = CONFIG.maxLives;
    state.apples = [];
    state.basketX = CONFIG.baseWidth / 2 - CONFIG.basket.width / 2;
    state.pointerTargetX = null;
    state.spawnTimer = 0;
    state.spawnInterval = CONFIG.apple.spawnIntervalStart;
    state.appleSpeed = CONFIG.apple.minSpeed;
    state.particles = [];
    updateHud();
  }

  // ---------------------------------------------------------------------
  // HUD
  // ---------------------------------------------------------------------
  function updateHud() {
    scoreValueEl.textContent = String(state.score);
    livesValueEl.innerHTML = '';
    for (let i = 0; i < CONFIG.maxLives; i++) {
      const span = document.createElement('span');
      span.className = 'heart';
      span.textContent = i < state.lives ? '❤️' : '🤍';
      livesValueEl.appendChild(span);
    }
  }

  // ---------------------------------------------------------------------
  // Input handling: keyboard
  // ---------------------------------------------------------------------
  window.addEventListener('keydown', (e) => {
    if (['ArrowLeft', 'a', 'A'].includes(e.key)) { state.keys.left = true; state.pointerTargetX = null; }
    if (['ArrowRight', 'd', 'D'].includes(e.key)) { state.keys.right = true; state.pointerTargetX = null; }
  });

  window.addEventListener('keyup', (e) => {
    if (['ArrowLeft', 'a', 'A'].includes(e.key)) state.keys.left = false;
    if (['ArrowRight', 'd', 'D'].includes(e.key)) state.keys.right = false;
  });

  // ---------------------------------------------------------------------
  // Input handling: mouse / touch (drag basket directly under pointer)
  // ---------------------------------------------------------------------
  function pointerXToGameX(clientX) {
    const rect = canvas.getBoundingClientRect();
    const relativeX = clientX - rect.left;
    return relativeX / scaleFactor;
  }

  function handlePointerMove(clientX) {
    if (!state.running) return;
    const gameX = pointerXToGameX(clientX);
    state.pointerTargetX = gameX - CONFIG.basket.width / 2;
  }

  canvas.addEventListener('mousemove', (e) => handlePointerMove(e.clientX));
  canvas.addEventListener('mousedown', (e) => handlePointerMove(e.clientX));

  canvas.addEventListener('touchstart', (e) => {
    if (e.touches[0]) handlePointerMove(e.touches[0].clientX);
  }, { passive: true });

  canvas.addEventListener('touchmove', (e) => {
    if (e.touches[0]) handlePointerMove(e.touches[0].clientX);
    e.preventDefault();
  }, { passive: false });

  // ---------------------------------------------------------------------
  // Spawning
  // ---------------------------------------------------------------------
  function spawnApple() {
    const margin = CONFIG.apple.radius + 6;
    const x = margin + Math.random() * (CONFIG.baseWidth - margin * 2);
    state.apples.push({
      x,
      y: -CONFIG.apple.radius,
      speed: state.appleSpeed * (0.85 + Math.random() * 0.3),
      wobble: Math.random() * Math.PI * 2,
      wobbleSpeed: 1.5 + Math.random() * 1.5,
    });
  }

  // ---------------------------------------------------------------------
  // Difficulty scaling
  // ---------------------------------------------------------------------
  function applyDifficultyRamp() {
    const { rampEveryPoints, speedIncreasePerRamp, spawnDecreasePerRamp } = CONFIG.difficulty;
    const rampLevel = Math.floor(state.score / rampEveryPoints);

    state.appleSpeed = Math.min(
      CONFIG.apple.maxSpeedCap,
      CONFIG.apple.minSpeed + rampLevel * speedIncreasePerRamp
    );
    state.spawnInterval = Math.max(
      CONFIG.apple.spawnIntervalMin,
      CONFIG.apple.spawnIntervalStart - rampLevel * spawnDecreasePerRamp
    );
  }

  // ---------------------------------------------------------------------
  // Particles (small catch/miss feedback bursts)
  // ---------------------------------------------------------------------
  function spawnParticles(x, y, color, count) {
    for (let i = 0; i < count; i++) {
      const angle = Math.random() * Math.PI * 2;
      const speed = 60 + Math.random() * 120;
      state.particles.push({
        x, y,
        vx: Math.cos(angle) * speed,
        vy: Math.sin(angle) * speed - 60,
        life: 0.6,
        maxLife: 0.6,
        color,
      });
    }
  }

  function updateParticles(dt) {
    for (let i = state.particles.length - 1; i >= 0; i--) {
      const p = state.particles[i];
      p.life -= dt;
      if (p.life <= 0) {
        state.particles.splice(i, 1);
        continue;
      }
      p.vy += 300 * dt; // gravity
      p.x += p.vx * dt;
      p.y += p.vy * dt;
    }
  }

  function drawParticles() {
    for (const p of state.particles) {
      const alpha = Math.max(0, p.life / p.maxLife);
      ctx.globalAlpha = alpha;
      ctx.fillStyle = p.color;
      ctx.beginPath();
      ctx.arc(p.x, p.y, 4, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.globalAlpha = 1;
  }

  // ---------------------------------------------------------------------
  // Update loop
  // ---------------------------------------------------------------------
  function update(dt) {
    // --- Basket movement ---
    const basket = CONFIG.basket;

    if (state.pointerTargetX !== null) {
      // Smoothly ease toward pointer position
      const diff = state.pointerTargetX - state.basketX;
      state.basketX += diff * Math.min(1, dt * 14);
    } else {
      if (state.keys.left) state.basketX -= basket.speed * dt;
      if (state.keys.right) state.basketX += basket.speed * dt;
    }

    state.basketX = Math.max(0, Math.min(CONFIG.baseWidth - basket.width, state.basketX));

    // --- Spawning ---
    state.spawnTimer += dt * 1000;
    if (state.spawnTimer >= state.spawnInterval) {
      state.spawnTimer = 0;
      spawnApple();
    }

    // --- Apples ---
    const basketTop = CONFIG.baseHeight - 90;
    const basketLeft = state.basketX;
    const basketRight = state.basketX + basket.width;

    for (let i = state.apples.length - 1; i >= 0; i--) {
      const apple = state.apples[i];
      apple.y += apple.speed * dt;
      apple.wobble += apple.wobbleSpeed * dt;

      const wobbleX = apple.x + Math.sin(apple.wobble) * 6;
      const r = CONFIG.apple.radius;

      // Catch detection: apple center within basket bounds & near basket top
      const withinBasketX = wobbleX + r > basketLeft + 8 && wobbleX - r < basketRight - 8;
      const atBasketHeight = apple.y + r >= basketTop && apple.y - r <= basketTop + 30;

      if (withinBasketX && atBasketHeight) {
        state.apples.splice(i, 1);
        state.score += 1;
        applyDifficultyRamp();
        updateHud();
        spawnParticles(wobbleX, apple.y, '#E53935', 10);
        continue;
      }

      // Missed: fell past bottom of canvas
      if (apple.y - r > CONFIG.baseHeight) {
        state.apples.splice(i, 1);
        state.lives -= 1;
        updateHud();
        spawnParticles(wobbleX, CONFIG.baseHeight - 10, '#888888', 8);

        if (state.lives <= 0) {
          endGame();
          return;
        }
      }
    }

    updateParticles(dt);
  }

  // ---------------------------------------------------------------------
  // Drawing
  // ---------------------------------------------------------------------
  function drawBackground() {
    ctx.clearRect(0, 0, CONFIG.baseWidth, CONFIG.baseHeight);

    const grad = ctx.createLinearGradient(0, 0, 0, CONFIG.baseHeight);
    grad.addColorStop(0, '#A8DDF0');
    grad.addColorStop(1, '#F0FAF0');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, CONFIG.baseWidth, CONFIG.baseHeight);

    // Ground strip
    ctx.fillStyle = '#DCEFD1';
    ctx.fillRect(0, CONFIG.baseHeight - 40, CONFIG.baseWidth, 40);
  }

  function drawBasket() {
    const b = CONFIG.basket;
    const x = state.basketX;
    const y = CONFIG.baseHeight - 90;

    ctx.save();
    ctx.translate(x, y);

    // Basket body (trapezoid)
    ctx.beginPath();
    ctx.moveTo(6, 12);
    ctx.lineTo(b.width - 6, 12);
    ctx.lineTo(b.width - 14, b.height);
    ctx.lineTo(14, b.height);
    ctx.closePath();
    ctx.fillStyle = CONFIG.basket === b ? '#A1887F' : '#A1887F';
    ctx.fill();
    ctx.strokeStyle = '#5D4037';
    ctx.lineWidth = 3;
    ctx.stroke();

    // Weave lines
    ctx.strokeStyle = 'rgba(93, 64, 55, 0.5)';
    ctx.lineWidth = 1.5;
    for (let i = 1; i < 4; i++) {
      const yy = 12 + (b.height - 12) * (i / 4);
      ctx.beginPath();
      ctx.moveTo(8 + i, yy);
      ctx.lineTo(b.width - 8 - i, yy);
      ctx.stroke();
    }

    // Rim
    ctx.beginPath();
    ctx.ellipse(b.width / 2, 12, b.width / 2, 8, 0, 0, Math.PI * 2);
    ctx.fillStyle = '#8D6E63';
    ctx.fill();
    ctx.strokeStyle = '#5D4037';
    ctx.stroke();

    ctx.restore();
  }

  function drawApple(apple) {
    const r = CONFIG.apple.radius;
    const wobbleX = apple.x + Math.sin(apple.wobble) * 6;

    ctx.save();
    ctx.translate(wobbleX, apple.y);

    // Shadow
    ctx.beginPath();
    ctx.ellipse(0, r + 4, r * 0.7, r * 0.22, 0, 0, Math.PI * 2);
    ctx.fillStyle = 'rgba(0,0,0,0.12)';
    ctx.fill();

    // Body
    const bodyGrad = ctx.createRadialGradient(-r * 0.35, -r * 0.35, r * 0.2, 0, 0, r);
    bodyGrad.addColorStop(0, '#FF6F60');
    bodyGrad.addColorStop(1, '#D32F2F');
    ctx.beginPath();
    ctx.arc(0, 0, r, 0, Math.PI * 2);
    ctx.fillStyle = bodyGrad;
    ctx.fill();

    // Leaf
    ctx.beginPath();
    ctx.ellipse(6, -r - 2, 7, 4, Math.PI / 4, 0, Math.PI * 2);
    ctx.fillStyle = '#2E7D32';
    ctx.fill();

    // Stem
    ctx.beginPath();
    ctx.moveTo(0, -r);
    ctx.quadraticCurveTo(2, -r - 8, -2, -r - 10);
    ctx.strokeStyle = '#4E342E';
    ctx.lineWidth = 2;
    ctx.stroke();

    // Highlight
    ctx.beginPath();
    ctx.ellipse(-r * 0.35, -r * 0.35, r * 0.28, r * 0.16, -0.5, 0, Math.PI * 2);
    ctx.fillStyle = 'rgba(255,255,255,0.5)';
    ctx.fill();

    ctx.restore();
  }

  function draw() {
    drawBackground();
    for (const apple of state.apples) drawApple(apple);
    drawBasket();
    drawParticles();
  }

  // ---------------------------------------------------------------------
  // Main loop
  // ---------------------------------------------------------------------
  function loop(timestamp) {
    if (!state.running) return;

    if (!state.lastTimestamp) state.lastTimestamp = timestamp;
    let dt = (timestamp - state.lastTimestamp) / 1000;
    dt = Math.min(dt, 0.05); // clamp to avoid huge jumps (e.g. tab switch)
    state.lastTimestamp = timestamp;

    update(dt);
    draw();

    state.animationFrameId = requestAnimationFrame(loop);
  }

  // ---------------------------------------------------------------------
  // Game lifecycle
  // ---------------------------------------------------------------------
  function startGame() {
    resetState();
    overlay.classList.add('hidden');
    state.lastTimestamp = 0;
    if (state.animationFrameId) cancelAnimationFrame(state.animationFrameId);
    state.animationFrameId = requestAnimationFrame(loop);
  }

  function endGame() {
    state.running = false;
    if (state.animationFrameId) cancelAnimationFrame(state.animationFrameId);

    overlay.classList.remove('hidden');
    overlay.querySelector('.panel').innerHTML = `
      <h1>🍎 Game Over</h1>
      <p class="stat-line">Final Score: <strong>${state.score}</strong></p>
      <p>You missed 3 apples. Give it another shot!</p>
      <button class="primary-btn" id="restart-btn">Play Again</button>
    `;
    document.getElementById('restart-btn').addEventListener('click', startGame);
  }

  // ---------------------------------------------------------------------
  // Init
  // ---------------------------------------------------------------------
  startBtn.addEventListener('click', startGame);

  resizeCanvas();
  updateHud();
  draw(); // render initial empty scene behind the start overlay
})();
</script>

</body>
</html>
